{
  "name": "@rgsoft/geometry",
  "version": "1.0.4",
  "description": "Geometry library",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "build": "tsup"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rgmiranda/rgsoft.git",
    "directory": "packages/geometry"
  },
  "keywords": [
    "geometry",
    "line",
    "segment",
    "planes",
    "polygon"
  ],
  "author": "Ricardo Miranda <rgmiranda@live.com.ar>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rgmiranda/rgsoft/issues"
  },
  "homepage": "https://github.com/rgmiranda/rgsoft/tree/main/packages/geometry/README.md",
  "dependencies": {
    "@rgsoft/linear": "workspace:^",
    "@rgsoft/math": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false
}
