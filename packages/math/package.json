{
  "name": "@rgsoft/math",
  "version": "2.0.0",
  "description": "Yet another JS math library",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "build": "tsup"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rgmiranda/rgsoft.git"
  },
  "keywords": [
    "math",
    "complex-numbers",
    "numbers",
    "prime-numbers",
    "factors",
    "totient",
    "digital-roots",
    "number-bases"
  ],
  "author": "Ricardo Miranda <rgmiranda@live.com.ar>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rgmiranda/rgsoft/issues"
  },
  "homepage": "https://github.com/rgmiranda/rgsoft#readme",
  "devDependencies": {
    "@vitest/coverage-v8": "^2.0.3",
    "ts-node": "^10.9.2",
    "tsup": "^8.1.0",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false
}
