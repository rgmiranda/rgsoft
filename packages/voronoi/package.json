{
  "name": "@rgsoft/voronoi",
  "version": "2.1.1",
  "description": "Voronoi tessellation library",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "build": "tsup"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rgmiranda/rgsoft.git"
  },
  "keywords": [
    "quadtree"
  ],
  "author": "Ricardo Miranda <rgmiranda@live.com.ar>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rgmiranda/rgsoft/issues"
  },
  "homepage": "https://github.com/rgmiranda/rgsoft#readme",
  "dependencies": {
    "@rgsoft/linear": "workspace:^",
    "@rgsoft/geometry": "workspace:^",
    "@rgsoft/math": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false
}
